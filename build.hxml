-lib hscript

# Handle main source directory
-p src

# Find main class that will target
-main Haxefetch

# Enable DCE to make compilation time less and not long
--dce full

# Optimize flags
-D analyzer-optimize
-D no-debug

# Compile to specific binary
-cpp bin/cpp

# Move compiled binary and rename it to correct name
--cmd command mv bin/cpp/Haxefetch bin/cpp/haxefetch

# Add resources
--resource src/resources/logos/aerynos.txt@aeryn
